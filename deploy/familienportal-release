#!/usr/bin/env bash
set -Eeuo pipefail
REPOSITORY=${FAMILIENPORTAL_GITHUB_REPOSITORY:-Markus4771/Familienportal}; API="https://api.github.com/repos/${REPOSITORY}/releases/latest"; APP_DIR=${FAMILIENPORTAL_APP_DIR:-/opt/familienportal}; TOKEN=${GITHUB_TOKEN:-${FAMILIENPORTAL_GITHUB_TOKEN:-}}
headers=(-H "Accept: application/vnd.github+json" -H "X-GitHub-Api-Version: 2022-11-28"); [[ -z "$TOKEN" ]] || headers+=(-H "Authorization: Bearer $TOKEN")
release_json(){ curl --fail --silent --show-error -L "${headers[@]}" "$API"; }
field(){ python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get(sys.argv[1],""))' "$1"; }
asset_url(){ python3 -c 'import json,sys
for a in json.load(sys.stdin).get("assets",[]):
 if a.get("name")==sys.argv[1]: print(a.get("browser_download_url", "")); break' "$1"; }
installed_version(){ [[ ! -x "$APP_DIR/.venv/bin/python" ]] || "$APP_DIR/.venv/bin/python" -c 'import familienportal; print(familienportal.__version__)' 2>/dev/null || true; }
check_release(){ local j t c; j=$(release_json); t=$(printf '%s' "$j"|field tag_name); c=$(installed_version); echo "Installiert: ${c:-nicht installiert}"; echo "Release:     ${t:-unbekannt}"; [[ -n "$c" && "v$c" == "$t" ]] && { echo "Status: aktuell"; return 0; }; echo "Status: Update verfügbar"; return 10; }
update_release(){
 [[ ${EUID} -eq 0 ]] || { echo "Update bitte als root ausführen." >&2; exit 1; }; local j tag ver deb url tmp; j=$(release_json); tag=$(printf '%s' "$j"|field tag_name); ver=${tag#v}; deb="familienportal_${ver}_all.deb"; url=$(printf '%s' "$j"|asset_url "$deb"); tmp=$(mktemp -d); trap 'rm -rf "$tmp"' EXIT
 if [[ -n "$url" ]]; then curl --fail --silent --show-error -L "${headers[@]}" -o "$tmp/$deb" "$url"; echo "Installiere $deb"; familienportalctl backup; apt-get install -y "$tmp/$deb"; "$APP_DIR/.venv/bin/alembic" -c "$APP_DIR/alembic.ini" upgrade head; systemctl restart familienportal.service; curl --fail --silent http://127.0.0.1:${FAMILIENPORTAL_BIND_PORT:-8000}/ready >/dev/null; echo "Update erfolgreich: $(installed_version)"; return; fi
 echo "Kein .deb-Asset für $tag vorhanden. Für produktive Updates muss das Release $deb enthalten." >&2; exit 3
}
case ${1:-check} in check) check_release;; update) update_release;; *) echo "Verwendung: $0 {check|update}" >&2; exit 2;; esac
