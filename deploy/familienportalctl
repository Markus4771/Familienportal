#!/usr/bin/env bash
set -Eeuo pipefail
APP_DIR=${FAMILIENPORTAL_APP_DIR:-/opt/familienportal}; CONFIG_DIR=${FAMILIENPORTAL_CONFIG_DIR:-/etc/familienportal}; DATA_DIR=${FAMILIENPORTAL_DATA_DIR:-/var/lib/familienportal}; BACKUP_DIR=${FAMILIENPORTAL_BACKUP_DIR:-/var/backups/familienportal}; SYSTEMD_DIR=/etc/systemd/system; SERVICE=familienportal.service
need_root(){ [[ ${EUID} -eq 0 ]] || { echo "Bitte als root ausführen." >&2; exit 1; }; }; stamp(){ date -u +%Y%m%dT%H%M%SZ; }; env_file(){ echo "$CONFIG_DIR/familienportal.env"; }
load_env(){ [[ ! -f "$(env_file)" ]] || { set -a; source "$(env_file)"; set +a; }; }
version(){ [[ ! -x "$APP_DIR/.venv/bin/python" ]] || "$APP_DIR/.venv/bin/python" -c 'import familienportal; print(familienportal.__version__)' 2>/dev/null || true; }
normalize_pg_url(){ local url=${1:-}; printf '%s' "${url/postgresql+psycopg:/postgresql:}"; }
backup(){
 need_root; local id target db_url; id=$(stamp); target="$BACKUP_DIR/$id"; install -d -m 0750 "$target"
 [[ ! -d "$APP_DIR" ]] || tar --exclude='opt/familienportal/.venv' -C / -czf "$target/application.tar.gz" opt/familienportal
 [[ ! -d "$CONFIG_DIR" ]] || tar -C / -czf "$target/config.tar.gz" etc/familienportal
 [[ ! -d "$DATA_DIR" ]] || tar -C / -czf "$target/data.tar.gz" var/lib/familienportal
 load_env; db_url=${FAMILIENPORTAL_DATABASE_URL:-}
 if [[ "$db_url" == postgresql* ]]; then pg_dump --format=custom --file="$target/database.dump" "$(normalize_pg_url "$db_url")"; elif [[ "$db_url" == sqlite:* ]]; then local p=${db_url#sqlite:///}; [[ ! -f "$p" ]] || cp -a "$p" "$target/database.sqlite3"; fi
 version > "$target/version.txt"; (cd "$target" && sha256sum ./* 2>/dev/null | grep -v checksums > checksums.sha256 || true); printf '%s\n' "$id" > "$BACKUP_DIR/latest"; chmod -R go-rwx "$target"; echo "$target"
}
list_backups(){ [[ -d "$BACKUP_DIR" ]] || return 0; for d in "$BACKUP_DIR"/20*; do [[ -d "$d" ]] || continue; printf '%s\t%s\n' "$(basename "$d")" "$(cat "$d/version.txt" 2>/dev/null || echo unbekannt)"; done; }
verify_backup(){ local t=${1:?Backup fehlt}; [[ -d "$t" ]] || t="$BACKUP_DIR/$t"; [[ -d "$t" ]] || return 2; [[ ! -f "$t/checksums.sha256" ]] || (cd "$t" && sha256sum -c checksums.sha256); }
install_units(){ for u in "$APP_DIR"/deploy/systemd/*.service "$APP_DIR"/deploy/systemd/*.timer; do install -o root -g root -m 0644 "$u" "$SYSTEMD_DIR/$(basename "$u")"; done; install -m 0755 "$APP_DIR/deploy/familienportalctl" /usr/local/sbin/familienportalctl; install -m 0755 "$APP_DIR/deploy/familienportal-release" /usr/local/sbin/familienportal-release; systemctl daemon-reload; }
rebuild_venv(){ rm -rf "$APP_DIR/.venv"; python3 -m venv "$APP_DIR/.venv"; "$APP_DIR/.venv/bin/python" -m pip install --upgrade pip; "$APP_DIR/.venv/bin/python" -m pip install "$APP_DIR"; chown -R familienportal:familienportal "$APP_DIR/.venv"; }
healthcheck(){ local p=${FAMILIENPORTAL_BIND_PORT:-8000}; for _ in {1..20}; do curl --fail --silent "http://127.0.0.1:${p}/health" >/dev/null 2>&1 && curl --fail --silent "http://127.0.0.1:${p}/ready" >/dev/null 2>&1 && return 0; sleep 1; done; return 1; }
restore(){
 need_root; local t=${1:-}; [[ -n "$t" ]] || { [[ -f "$BACKUP_DIR/latest" ]] || { echo "Kein Backup." >&2; exit 2; }; t=$(cat "$BACKUP_DIR/latest"); }; [[ -d "$t" ]] || t="$BACKUP_DIR/$t"; verify_backup "$t" || { echo "Backup-Prüfung fehlgeschlagen." >&2; exit 2; }
 systemctl stop "$SERVICE" 2>/dev/null || true; [[ ! -f "$t/application.tar.gz" ]] || { rm -rf "$APP_DIR"; tar -C / -xzf "$t/application.tar.gz"; }; [[ ! -f "$t/config.tar.gz" ]] || { rm -rf "$CONFIG_DIR"; tar -C / -xzf "$t/config.tar.gz"; }; [[ ! -f "$t/data.tar.gz" ]] || { rm -rf "$DATA_DIR"; tar -C / -xzf "$t/data.tar.gz"; }
 rebuild_venv; install_units; load_env; local db=${FAMILIENPORTAL_DATABASE_URL:-}; if [[ -f "$t/database.dump" && "$db" == postgresql* ]]; then pg_restore --clean --if-exists --no-owner --dbname="$(normalize_pg_url "$db")" "$t/database.dump"; elif [[ -f "$t/database.sqlite3" && "$db" == sqlite:* ]]; then local p=${db#sqlite:///}; install -d -o familienportal -g familienportal "$(dirname "$p")"; cp -a "$t/database.sqlite3" "$p"; chown familienportal:familienportal "$p"; fi
 systemctl restart "$SERVICE"; healthcheck || { echo "Wiederhergestellt, Dienst aber nicht gesund." >&2; exit 1; }; echo "Restore erfolgreich: $(version)"
}
update_from_dir(){
 need_root; local source=${1:?Quelle fehlt}; [[ -f "$source/pyproject.toml" ]] || { echo "Ungültige Quelle." >&2; exit 2; }; local b; b=$(backup); echo "Backup: $b"; systemctl stop "$SERVICE" 2>/dev/null || true; local s; s=$(mktemp -d); cp -a "$source"/. "$s"/; rm -rf "$s/.git" "$s/.venv"; find "$APP_DIR" -mindepth 1 -maxdepth 1 ! -name '.venv' -exec rm -rf {} +; cp -a "$s"/. "$APP_DIR"/; rm -rf "$s"; chown -R familienportal:familienportal "$APP_DIR"; rebuild_venv; install_units
 if ! "$APP_DIR/.venv/bin/alembic" -c "$APP_DIR/alembic.ini" upgrade head; then echo "Migration fehlgeschlagen; Rollback." >&2; restore "$b"; exit 1; fi
 systemctl enable "$SERVICE" >/dev/null; systemctl restart "$SERVICE"; load_env; if ! healthcheck; then echo "Healthcheck fehlgeschlagen; Rollback." >&2; restore "$b"; exit 1; fi; echo "Update erfolgreich: $(version)"
}
remove_app(){ need_root; local purge=${1:-}; systemctl disable --now "$SERVICE" 2>/dev/null || true; for t in familienportal-calendar-sync.timer familienportal-gramps-calendar-sync.timer familienportal-reminder-queue.timer familienportal-security-cleanup.timer; do systemctl disable --now "$t" 2>/dev/null || true; done; rm -f "$SYSTEMD_DIR"/familienportal*.service "$SYSTEMD_DIR"/familienportal*.timer /usr/local/sbin/familienportalctl /usr/local/sbin/familienportal-release; systemctl daemon-reload; rm -rf "$APP_DIR"; [[ "$purge" != --purge ]] || { rm -rf "$CONFIG_DIR" "$DATA_DIR" "$BACKUP_DIR"; userdel familienportal 2>/dev/null || true; }; }
status(){ echo "Version: $(version)"; echo "Anwendung: $APP_DIR"; echo "Konfiguration: $CONFIG_DIR"; echo "Daten: $DATA_DIR"; echo "Backups: $BACKUP_DIR"; systemctl --no-pager --full status "$SERVICE" || true; }
case ${1:-status} in backup) backup;; backups) list_backups;; verify-backup) verify_backup "${2:-}";; restore|rollback) restore "${2:-}";; update) update_from_dir "${2:-.}";; remove) remove_app "${2:-}";; status) status;; version) version;; *) echo "Verwendung: $0 {status|version|backup|backups|verify-backup <id>|restore [id]|update <source>|remove [--purge]}" >&2; exit 2;; esac
