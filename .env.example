FAMILIENPORTAL_ENVIRONMENT=production
FAMILIENPORTAL_DEBUG=false
FAMILIENPORTAL_DATABASE_URL=postgresql+psycopg://familienportal:CHANGE_ME@127.0.0.1/familienportal
FAMILIENPORTAL_DEFAULT_PROFILE=small_family

FAMILIENPORTAL_PUBLIC_URL=https://portal.example.de
FAMILIENPORTAL_BIND_HOST=0.0.0.0
FAMILIENPORTAL_BIND_PORT=8000
FAMILIENPORTAL_TRUSTED_HOSTS=portal.example.de,localhost,127.0.0.1
FAMILIENPORTAL_TRUSTED_PROXIES=192.168.1.10
FAMILIENPORTAL_SECURE_COOKIES=true
FAMILIENPORTAL_SESSION_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
