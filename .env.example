FAMILIENPORTAL_ENVIRONMENT=production
FAMILIENPORTAL_DEBUG=false
FAMILIENPORTAL_DATABASE_URL=postgresql+psycopg://familienportal:CHANGE_ME@127.0.0.1/familienportal
FAMILIENPORTAL_DEFAULT_PROFILE=small_family

FAMILIENPORTAL_PUBLIC_URL=https://portal.example.de
FAMILIENPORTAL_BIND_HOST=0.0.0.0
FAMILIENPORTAL_BIND_PORT=8000
FAMILIENPORTAL_TRUSTED_HOSTS=portal.example.de,localhost,127.0.0.1
FAMILIENPORTAL_TRUSTED_PROXIES=192.168.1.10
FAMILIENPORTAL_SECURE_COOKIES=true
FAMILIENPORTAL_SESSION_SECRET_KEY=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
FAMILIENPORTAL_SESSION_MAX_AGE_SECONDS=43200

# Sicherheit 0.7
# Separater Schlüssel zur Verschlüsselung von MFA-Seeds. Nicht mit dem Session-Key gleichsetzen.
FAMILIENPORTAL_SECURITY_ENCRYPTION_KEY=CHANGE_ME_WITH_ANOTHER_LONG_RANDOM_VALUE
FAMILIENPORTAL_PASSWORD_RESET_TTL_MINUTES=30
FAMILIENPORTAL_MFA_ISSUER=Familienportal
FAMILIENPORTAL_REQUIRE_ADMIN_MFA=false

# Sicherheit 0.7.1
FAMILIENPORTAL_LOGIN_MAX_FAILURES=5
FAMILIENPORTAL_LOGIN_WINDOW_MINUTES=15
FAMILIENPORTAL_LOGIN_LOCK_MINUTES=15
# Normalerweise aus PUBLIC_URL ableitbar. Bei abweichender WebAuthn-Domain explizit setzen.
FAMILIENPORTAL_WEBAUTHN_RP_ID=portal.example.de
FAMILIENPORTAL_WEBAUTHN_RP_NAME=Familienportal
FAMILIENPORTAL_WEBAUTHN_ORIGIN=https://portal.example.de

# Kalender-Worker
FAMILIENPORTAL_WORKER_INTERVAL_SECONDS=60
FAMILIENPORTAL_CALENDAR_SYNC_INTERVAL_MINUTES=5

# SMTP, z. B. über Mailcow
FAMILIENPORTAL_SMTP_HOST=mail.example.de
FAMILIENPORTAL_SMTP_PORT=587
FAMILIENPORTAL_SMTP_USERNAME=portal@example.de
FAMILIENPORTAL_SMTP_PASSWORD=CHANGE_ME
FAMILIENPORTAL_SMTP_FROM=portal@example.de
FAMILIENPORTAL_SMTP_STARTTLS=true

# Connector-Secrets; in der Connector-Konfiguration wird nur der Variablenname gespeichert
FAMILIENPORTAL_NEXTCLOUD_APP_PASSWORD=CHANGE_ME
FAMILIENPORTAL_MAILCOW_API_KEY=CHANGE_ME
